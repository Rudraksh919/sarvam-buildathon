# Sarvam (required for live AI; without it demo mode uses a labelled scripted provider)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_TIMEOUT_S=60
# Repository to inspect (absolute or relative path). Defaults to the bundled demo repo.
REPO_PATH=
# Slack (optional)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Linear (optional)
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# PostHog (optional)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com
# Sentry (optional)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_HOST=https://sentry.io
# Investigation tuning
CONFIDENCE_THRESHOLD=0.6
HTTP_TIMEOUT_S=15
PORT=3000
